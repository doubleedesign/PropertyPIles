@rendermode InteractiveServer

<section id="@Id" class="property-list" data-size="wide">
    <h2>@Title</h2>
    
    @if (_isLoading) {
        <div class="property-list__loading">
            <p>Loading &hellip;</p>
        </div>
    }
    else if (Items.Count > 0) {
        <table class="property-list__table">
            <thead>
            <tr class="property-list__table__header">
                <th data-key="address">Address</th>
                <th data-key="price">Price</th>
                <th data-key="days-on-market" title="Days on market">Days on market</th>
                <th data-key="specs">Rooms</th>
                <th data-key="size">Land size</th>
                <th data-key="notes">@(Id == "dismissed" ? "Dismissed because" : "Notes")</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var Item in Items) {
                <tr class="property-list__table__row" data-property-id="@Item.Id" data-status="@Item.Data?.Status">
                    <td data-key="address">
                        <p class="address">
                            <a href="@Item.GetUrl()" target="_blank">
                                @(string.IsNullOrEmpty(Item.GetFormattedAddress()) ? Item.GetShortAddress() : Item.GetFormattedAddress())
                            </a>
                            @if (Item.Data?.Status == "Archived") {
                                <span class="badge" data-key="Removed">Removed</span>
                            }
                            else if (Item.Data?.Status != "Live") {
                                <span class="badge" data-key="@Item.Data?.Status">@Item.Data?.Status</span>
                            }
                        </p>
                        <p class="description">
                            @if ((ListName != "dismissed" && ListName != "sold") && (Item.Data?.Status == "Live" || Item.Data?.Status == "New")) {
                                <span>“@Item.Data?.ShortDescription”</span>
                            }
                        </p>
                    </td>
                    <td data-key="price">@Item.Data?.Price</td>
                    <td data-key="days-on-market" aria-label="Days on market">
                        @Item.Data?.DaysOnMarket
                    </td>
                    <td data-key="specs">
                        <PropertySpecs 
                            Bedrooms="@Item.Data?.Bedrooms" 
                            Bathrooms="@Item.Data?.Bathrooms"
                            Carspaces="@Item.Data?.Carspaces"
                        />
                    </td>
                    <td data-key="size" aria-label="Land size">
                        @Item.Data?.LandArea
                    </td>
                    <td data-key="notes" aria-label='@(Id == "dismissed" ? "Dismissed because" : "Notes")'>
                        @if (Item.GetNotes().Count > 0) {
                            <ul>
                                @foreach (var note in Item.GetNotes()) {
                                    <li>@note</li>
                                }
                            </ul>
                        }
                        @if (Item.Data?.Status == "Live" && Item.Data?.Status != "Sold" && Id != "dismissed") {
                            <PropertyInternet CoverageData="Item.NbnCoverage"/>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else {
        <p class="property-list__empty">We donʼt have any properties in this list yet.</p>
    }
</section>