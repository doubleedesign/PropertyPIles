<section id="@Id" class="property-list" data-size="wide">
    <h2>@Title</h2>
    
    @if (_isLoading) {
        <div class="property-list__loading">
            <p>Loading &hellip;</p>
        </div>
    }
    else if (Items.Count > 0) {
        <table class="property-list__table">
            <thead>
            <tr class="property-list__table__header">
                <td data-key="address">Address</td>
                <td data-key="price">Price</td>
                <td data-key="specs">Details</td>
                <td data-key="size">Land size</td>
                <td data-key="days-on-market">Days on market</td>
                <td data-key="notes">@(Id == "dismissed" ? "Dismissed because" : "Notes")</td>
            </tr>
            </thead>
            <tbody>
            @foreach (var Item in Items) {
                <tr class="property-list__table__row" data-property-id="@Item.Id" data-status="@Item.Data?.Status">
                    <td data-key="address">
                        @if (Item.Data?.Status == "Archived") {
                            <span class="badge" data-key="Removed">Removed</span>
                        }
                        else if (Item.Data?.Status != "Live") {
                            <span class="badge" data-key="@Item.Data?.Status">@Item.Data?.Status</span>
                        }
                        <a href="@Item.GetUrl()" target="_blank">@Item.GetFormattedAddress()</a>
                        <span>“@Item.Data?.ShortDescription”</span>
                    </td>
                    <td data-key="price">@Item.Data?.Price</td>
                    <td data-key="specs" aria-label="Property specifications">
                        <PropertySpecs 
                            Bedrooms="@Item.Data?.Bedrooms" 
                            Bathrooms="@Item.Data?.Bathrooms"
                            Carspaces="@Item.Data?.Carspaces"
                        />
                    </td>
                    <td data-key="size" aria-label="Land size">
                        @Item.Data?.LandArea
                    </td>
                    <td data-key="days-on-market" aria-label="Days on market">
                        @Item.Data?.DaysOnMarket
                    </td>
                    <td data-key="notes">@Item.GetFormattedNotes()</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else {
        <p class="property-list__empty">We donʼt have any properties in this list yet.</p>
    }
</section>