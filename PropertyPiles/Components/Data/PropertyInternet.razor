@using PropertyPiles.Components.Elements

<div class="property-internet">
    <details class="property-internet__links">
        <summary class="property-internet__links__toggle">
            <span class="property-internet__label">NBN or private fibre coverage</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M256 512a256 256 0 1 0 0-512 256 256 0 1 0 0 512zm0-336c-17.7 0-32 14.3-32 32 0 13.3-10.7 24-24 24s-24-10.7-24-24c0-44.2 35.8-80 80-80s80 35.8 80 80c0 47.2-36 67.2-56 74.5l0 3.8c0 13.3-10.7 24-24 24s-24-10.7-24-24l0-8.1c0-20.5 14.8-35.2 30.1-40.2 6.4-2.1 13.2-5.5 18.2-10.3 4.3-4.2 7.7-10 7.7-19.6 0-17.7-14.3-32-32-32zM224 368a32 32 0 1 1 64 0 32 32 0 1 1 -64 0z"/></svg>
        </summary>
        <div class="property-internet__links__content">
            <ul>
                <li><ExternalLink Href="https://www.iinet.net.au/internet-product/broadband/nbn/plans/fibre" Label="Check iiNet NBN"/></li>
                <li><ExternalLink Href="https://www.iinet.net.au/internet-product/broadband/cable" Label="Check iiNet Cable"/></li>
                <li><ExternalLink Href="https://www.aussiebroadband.com.au/internet/opticomm-plans/" Label="Check Aussie Broadband (NBN or Opticomm)"/></li>
            </ul>
        </div>
    </details>
    @if (CoverageData == null) {
        <p>Internet coverage unknown.</p>
    }
    else {
        <dl class="property-internet__data">
            <span>
                <dd>Type</dd><dt>@CoverageData.Type</dt>
            </span>
            <span>
                <dd>Technology</dd><dt>@CoverageData.Technology</dt>
            </span>
            @if (!string.IsNullOrEmpty(CoverageData.AlternateTechology)) {
                <span>
                    <dd>Alternate technology</dd>
                    <dt>@CoverageData.AlternateTechology</dt>
                </span>
            }
            <span>
                <dd><ExternalLink Href="https://www.aussiebroadband.com.au/help-centre/internet/what-is-my-service-class-and-what-does-it-mean/" Label="Service class"/></dd>
                <dt>@CoverageData.ServiceClass</dt>
            </span>
            <span>
                <dd>Speed potential</dd>
                <dt>@CoverageData.GetFormattedDownloadSpeed() down, @CoverageData.GetFormattedUploadSpeed() up</dt>
            </span>
        </dl>
    }
</div>

