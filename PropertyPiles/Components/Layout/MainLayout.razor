@inherits LayoutComponentBase
@rendermode InteractiveServer

<PageTitle>Property Piles</PageTitle>

<SiteHeader/>
@if (_isAuthorised) {
    <main id="top">
        @Body
    </main>
}
else {
    <section class="login" data-size="wide">
        <form @onsubmit="Login">
            <input type="password" @bind="_inputPassword" placeholder="Enter password"/>
            <button type="submit">Log in</button>
        </form>
        @if (_loginFailed) {
            <p class="login__error">Incorrect password.</p>
        }
    </section>
}